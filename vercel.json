{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/tasks", "dest": "/api/tasks.js" },
    { "src": "/api/tasks/(.*)", "dest": "/api/tasks.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
